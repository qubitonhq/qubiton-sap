# QubitOn SAP S/4HANA connector — sample secrets file
#
# Copy this file to `.env` and replace the placeholder values. The real
# `.env` is gitignored (see .gitignore); this `.env.example` is checked
# in as a template so contributors know what's expected.
#
# These values are NOT read directly by the ABAP code at runtime — ABAP
# pulls credentials from the SM59 destination "QUBITON" and (optionally)
# from class-data `mv_apikey`. This file is for local development
# tooling, BTP destination setup scripts, and the abapGit deployment
# pipeline.

# ── QubitOn API ─────────────────────────────────────────────────────────
# Sign up and generate a key at https://www.qubiton.com/auth/register
QUBITON_API_KEY=replace-with-your-key

# Public QubitOn API base URL — keep as-is for production.
QUBITON_API_BASE_URL=https://api.qubiton.com

# ── SM59 / BTP destination ─────────────────────────────────────────────
# RFC destination name created in SM59 (type G, SSL, port 443) or as a
# Communication Arrangement on BTP. The ABAP code reads from this name
# (see ZCL_QUBITON->MV_DESTINATION); keep "QUBITON" unless you have a
# naming-convention reason to change it on both ends.
SAP_DESTINATION=QUBITON

# ── SAP system (deployment-time only) ──────────────────────────────────
# Used by deployment scripts under scripts/ to push transports.
SAP_SYSTEM_ID=DEV
SAP_CLIENT=100
SAP_USER=replace-with-your-user
SAP_PASSWORD=replace-with-your-password
